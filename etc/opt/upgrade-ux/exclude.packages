# If you need to exclude some software packages for HP-UX or Linux list them here one per line, e.g.
# SecureShell (for HP-UX software depot package name)
# or nmap (for Linux RPM package)
docker*
containerd*
rke2*
# For issue #146 we add observability-tools to the exclude list to avoid conflicts with jq package
observability-tools
# as iotop is installed by Chef we may not upgrade the package to iotop-c as chef fails afterwards
iotop*
